{
  "info": {
    "name": "Omnihub API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "version",
      "value": "v1"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/{{version}}/auth/health"
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/{{version}}/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPassword123!\",\n  \"display_name\": \"Jane Doe\",\n  \"timezone\": \"America/New_York\",\n  \"birthdate\": \"1990-05-15\",\n  \"preferred_language\": \"en\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/{{version}}/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPassword123!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Workspace",
      "item": [
        {
          "name": "Create Workspace",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/{{version}}/organizations",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Workspace\",\n  \"slug\": \"acme-workspace\"\n}"
            }
          }
        },
        {
          "name": "Get Workspace",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/{{version}}/organizations/:workspace_id",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "variable": [
              {
                "key": "workspace_id",
                "value": ""
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Identity",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/identity/health"
          }
        }
      ]
    }
  ]
}
