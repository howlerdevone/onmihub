# ─────────────────────────────────────────────
# NOTE: Secrets for this project are managed with Doppler.
#   Primary path:  install the Doppler CLI, then run `doppler setup`
#                  (project: omnihub, config: dev_personal), and launch
#                  commands via `just` (which wraps them in `doppler run`).
#   Fallback:      copy this file to `.env` — the loader in
#                  src/omnihub/config/dotenv.py will pick it up if Doppler
#                  did not already inject the variables.
# The keys below document what Doppler (or `.env`) must provide.
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# Supabase (required)
# ─────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────
# Database (required — no implicit fallback)
# ─────────────────────────────────────────────
DATABASE_URL=postgres://omni_user:omni_password@localhost:5433/omnihub_dev

# ─────────────────────────────────────────────
# Server (optional — defaults shown)
# ─────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# Set to true to enable auto-reload (development only)
OMNIHUB_RELOAD=false

# ─────────────────────────────────────────────
# Redis (optional — for Celery task queue)
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────
# Google Cloud Storage
# ─────────────────────────────────────────────
# BUCKET_NAME is required. Credentials are optional: with neither variable below
# set, Application Default Credentials are used — the attached service account on
# a managed runtime, or `gcloud auth application-default login` locally.
# When set, GOOGLE_APPLICATION_CREDENTIALS may be a path to a key file or the
# same JSON base64-encoded; GCS_CREDENTIALS_JSON takes a raw JSON payload.
# A value that is set but unresolvable fails startup rather than falling back.
BUCKET_NAME=your-shared-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/sa.json
# GCS_CREDENTIALS_JSON={"type":"service_account",...}
